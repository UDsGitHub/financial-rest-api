# Copy to .env and fill in your values:
#   cp .env.example .env

# Alpha Vantage — https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_api_key_here
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query

# Redis (watchlist, rate limits, API response cache)
REDIS_URL=localhost
# Use 6379 for brew/redis-server. If Docker Redis maps host 6380->6379, set REDIS_PORT=6380
# (macOS often runs brew Redis on 6379; the app then hits brew, not the Docker container)
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# Cache TTL in seconds for successful Alpha Vantage responses (daily OHLCV; 86400 = 24h)
CACHE_TTL=86400

# Per-client HTTP rate limiting (not the same as Alpha Vantage upstream limits)
RATE_LIMIT_WINDOW=60
MAX_REQUESTS_PER_MINUTE=4

# Caps to reduce Alpha Vantage usage (each symbol may trigger an upstream call)
MAX_SCAN_SYMBOLS=3
MAX_WATCHLIST_SIZE=3

# Global Alpha Vantage upstream budget (cache misses only; shared by all clients)
AV_MAX_PER_MINUTE=4
AV_MAX_PER_DAY=24

# Production HTTPS (EC2 + docker compose --profile prod)
# Point your domain's A record at the Elastic IP before starting Caddy.
DOMAIN=api.example.com
ACME_EMAIL=you@example.com
